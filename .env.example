# Source locations for tools/generate.py and scripts/ (copy to .env and edit).
# ~ and $VARIABLES are expanded; the environment overrides this file.

# game installs
ARTIFACT_CLASSIC=~/.local/share/Steam/steamapps/common/Artifact
ARTIFACT_FOUNDRY=~/.local/share/Steam/steamapps/common/Artifact 2.0
# Dota 2 (regions.txt for commons/regions.json; optional)
DOTA2=~/.local/share/Steam/steamapps/common/dota 2 beta

# repositories
ORIGINAL_META=~/code/artifact/original-meta
REBORN_CONTENT=~/code/artifact/artifact-reborn-content
REBORN_GC=~/code/artifact/artifact-reborn-gc
REPLAY_PARSER=~/code/artifact/replay-parser
